{
  "name": "set-demo",
  "version": "0.2.0",
  "description": "Feature demos recorded from a real web app: one scenario YAML → MP4 + a self-contained HTML page, with cursor, spotlight and an expectation gate.",
  "type": "module",
  "license": "MIT",
  "author": "Gábor Tatár",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tatargabor/set-demo.git"
  },
  "homepage": "https://github.com/tatargabor/set-demo#readme",
  "bugs": "https://github.com/tatargabor/set-demo/issues",
  "bin": {
    "set-demo": "src/cli.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "examples",
    "set-demo.config.example.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "playwright-recast": "^0.19.2"
  },
  "scripts": {
    "demo": "node src/cli.mjs"
  },
  "keywords": [
    "playwright",
    "demo",
    "screencast",
    "release-notes",
    "product-demo",
    "gif",
    "walkthrough"
  ]
}
